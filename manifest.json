{
  "manifest_version": 3,
  "name": "QuickQR – QR Code Generator",
  "short_name": "QuickQR",
  "description": "Generate QR codes instantly from any text, URL, email, phone number, or Wi-Fi info. Download as PNG with one click.",
  "version": "1.0.0",
  "author": "QuickQR",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "QuickQR – Generate QR Codes"
  },
  "permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
